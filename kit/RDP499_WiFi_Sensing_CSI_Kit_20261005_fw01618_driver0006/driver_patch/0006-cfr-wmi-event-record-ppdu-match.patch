+/* Called by the WMI parser for every WMI_PEER_CFR_CAPTURE_EVENT, with the event's TLVs as
+ * received (bit 3 of cfr_rxmeta). Only while CFR is enabled on the event's pdev.
+ */
+void ath12k_cfr_wmi_event_raw(struct ath12k_base *ab,
+			      const struct ath12k_cfr_peer_tx_param *params,
+			      const void *raw, u32 len)
+{
+	struct cfr_rxmeta_rec_hdr *h = (struct cfr_rxmeta_rec_hdr *)s_cfr_wmievt_rec;
+	u32 end_magic = ATH12K_CFR_END_MAGIC;
+	struct ath12k_link_vif *arvif;
+	struct ath12k *ar;
+	u32 n;
+
+	rcu_read_lock();
+	arvif = ath12k_mac_get_arvif_by_vdev_id(ab, params->vdev_id);
+	ar = arvif ? arvif->ar : NULL;
+	rcu_read_unlock();
+	if (!ar || !READ_ONCE(ar->cfr.cfr_enabled))
+		return;
+
+	ath12k_cfr_wmievt_seen++;
+	if (!(ath12k_cfr_rxmeta & BIT(3)))
+		return;
+
+	n = min_t(u32, len, CFR_WMIEVT_RAW_MAX);
+	spin_lock_bh(&s_cfr_rxmeta_lock);
+	h->magic = CFR_WMIEVT_MAGIC;
+	h->ppdu_id = FIELD_GET(WMI_CFR_CORRELATION_INFO2_PPDU_ID,
+			       params->correlation_info_2);
+	h->pdev_idx = ar->pdev_idx;
+	h->ntlv = CFR_WMIEVT_VERSION;
+	h->host_ts_ns = ktime_to_ns(ktime_get_real());
+	memcpy(s_cfr_wmievt_rec + sizeof(*h), raw, n);
+	memset(s_cfr_wmievt_rec + sizeof(*h) + n, 0, ALIGN(n, 4) - n);
+	h->tlv_bytes = ALIGN(n, 4);
+	ath12k_cfr_rfs_write(ar, s_cfr_wmievt_rec, sizeof(*h) + ALIGN(n, 4), NULL, 0,
+			     &end_magic, sizeof(end_magic));
+	spin_unlock_bh(&s_cfr_rxmeta_lock);
+}
