-					       u32 cf1_mhz, u32 cf2_mhz)
+					       bool enable, u32 vdev_id, u32 bw,
+					       u32 prim_mhz, u32 cf1_mhz, u32 cf2_mhz)
 {
 }
 #endif /* CPTCFG_ATH12K_CFR */
