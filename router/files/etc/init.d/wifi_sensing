#!/bin/sh /etc/rc.common
# wifi_sensing: daemon phát hiện vẫy tay bằng CSI. Cấu hình: /etc/config/wifi_sensing.
# Sau cfr9650_driver (S03) và wifi; trạng thái: cat /tmp/wifi_sensing.status ; log: logread -e wifi_sensing
# Phát thử IPC trigger (không cần vẫy tay): /etc/init.d/wifi_sensing trigger
# Hiệu chỉnh nền (model inv_nb; PHÒNG YÊN, không ai cử động): /etc/init.d/wifi_sensing calibrate

START=99
EXTRA_COMMANDS="trigger calibrate"
EXTRA_HELP="	trigger	Phát IPC trigger một lần (như khi phát hiện vẫy tay), để bên tích hợp kiểm tra
	calibrate	Đo nền khi phòng yên (calib_s giây, mặc định 30) → baseline; làm lại khi dời router/station"
STOP=10
USE_PROCD=1
BIN=/root/wifi_sensing/wifi_sensing

load_args() {
	config_load wifi_sensing
	local ap_if hw station station_ip period_ms keepawake_ms baseline
	config_get ap_if main ap_if phy00.2-0
	config_get hw main hw ath12k_hw2
	config_get station main station auto
	config_get station_ip main station_ip ''
	config_get period_ms main period_ms 50
	config_get keepawake_ms main keepawake_ms 5
	config_get baseline main baseline /root/wifi_sensing/baseline.txt
	ARGS="-i $ap_if -H $hw -s $station -p $period_ms -k $keepawake_ms -b $baseline"
	[ -n "$station_ip" ] && ARGS="$ARGS -a $station_ip"
}

start_service() {
	config_load wifi_sensing
	local enabled ap_if hw station station_ip period_ms keepawake_ms on_th off_th consecutive cooldown_s action baseline
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get baseline main baseline /root/wifi_sensing/baseline.txt
	config_get ap_if main ap_if phy00.2-0
	config_get hw main hw ath12k_hw2
	config_get station main station auto
	config_get station_ip main station_ip ''
	config_get period_ms main period_ms 50
	config_get keepawake_ms main keepawake_ms 5
	config_get on_th main on_threshold 0.7
	config_get off_th main off_threshold 0.4
	config_get consecutive main consecutive 2
	config_get cooldown_s main cooldown_s 5
	config_get action main action ''

	procd_open_instance
	procd_set_param command "$BIN" -i "$ap_if" -H "$hw" -s "$station" -a "$station_ip" -p "$period_ms" \
		-k "$keepawake_ms" -t "$on_th" -T "$off_th" -n "$consecutive" -C "$cooldown_s" -x "$action" -b "$baseline"
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

trigger() {
	local action
	config_load wifi_sensing
	config_get action main action ''
	[ -n "$action" ] || { echo "wifi_sensing: action trống"; return 1; }
	WS_P=1.000 WS_STATION=manual WS_TS=$(date +%s) sh -c "$action" && echo "wifi_sensing: đã phát trigger"
}

calibrate() {
	local secs running=0
	config_load wifi_sensing
	config_get secs main calib_s 30
	load_args
	pidof wifi_sensing >/dev/null && running=1 && /etc/init.d/wifi_sensing stop && sleep 1
	echo "wifi_sensing: hiệu chỉnh ${secs} s — giữ phòng YÊN (không ai đi lại / vẫy tay)"
	$BIN $ARGS --calibrate "$secs"
	local rc=$?
	[ "$running" = 1 ] && /etc/init.d/wifi_sensing start
	[ "$rc" = 0 ] && echo "wifi_sensing: xong" || echo "wifi_sensing: hiệu chỉnh LỖI ($rc) — giữ nền cũ"
	return $rc
}

service_triggers() {
	procd_add_reload_trigger wifi_sensing
}
